{
    "name": "vadimermolenko8787/scanner-trap",
    "description": "Blacklists vulnerability scanners on their first probe of a decoy path such as /.env. File, Redis or APCu storage, optional central database for several servers.",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "Vadym Yermolenko", "homepage": "https://github.com/vadimermolenko8787"}],
    "keywords": ["security", "scanner", "vulnerability-scanner", "honeypot", "blacklist", "ip-blocking", "firewall", "waf", "middleware", "psr-15", "redis"],
    "homepage": "https://github.com/vadimermolenko8787/scanner-trap",
    "support": {
        "issues": "https://github.com/vadimermolenko8787/scanner-trap/issues",
        "source": "https://github.com/vadimermolenko8787/scanner-trap",
        "security": "https://github.com/vadimermolenko8787/scanner-trap/security/policy"
    },
    "require": {
        "php": ">=8.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "predis/predis": "^2.2"
    },
    "suggest": {
        "ext-redis": "Redis local store (mode 1 or 2), or predis/predis",
        "predis/predis": "Redis local store without ext-redis",
        "ext-apcu": "APCu local store, one PHP server only",
        "ext-pdo": "Central store for several servers (mode 3): pdo_mysql, pdo_pgsql or pdo_sqlite"
    },
    "autoload": {
        "psr-4": {"ScannerTrap\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"ScannerTrap\\Tests\\": "tests/"}
    },
    "bin": ["bin/scanner-trap"],
    "scripts": {
        "test": "@php -d apc.enable_cli=1 -d apc.use_request_time=0 vendor/bin/phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.1.99"},
        "process-timeout": 0
    }
}
